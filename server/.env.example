# 赤牙·AI阅读 后端环境配置
# 复制此文件为 .env，并把下面的占位符换成你自己的真实值。
#
# ⚠️ 这个文件是**被 git 跟踪**的，会被推到远端 —— 永远不要在这里填真实密钥。
#    真实密钥只放在 server/.env（已在 .gitignore 中）或部署平台的 Variables 里。
#
# 取值地址：https://platform.deepseek.com/api_keys

# 大模型 API 配置（默认按 DeepSeek 的 OpenAI 兼容接口写）
LLM_API_KEY=sk-your-own-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 服务器端口
PORT=3001

# 数据目录（可选）。
# 不设置时用容器内的 server/data —— 那会在每次重新部署时被清空。
# 线上应挂一个持久化卷，并把这两项指向卷内路径，例如：
#   DATA_DIR=/data
#   UPLOAD_DIR=/data/uploads
# DATA_DIR=
# UPLOAD_DIR=

# 正文提取上限（可选，一般不用改）
# MAX_PDF_PAGES=1500      提取 PDF 的最大页数（用于「读原文」，不足会把正文截短）
# MAX_TEXT_CHARS=1500000  单本书保存的正文最大字数
